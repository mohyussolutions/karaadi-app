{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "base": {
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.karaadi.com"
      }
    },
    "development": {
      "extends": "base",
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development"
    },
    "preview": {
      "extends": "base",
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "channel": "preview"
    },
    "production": {
      "extends": "base",
      "autoIncrement": true,
      "channel": "production",
      "android": {
        "buildType": "app-bundle"
      },
      "ios": {
        "simulator": false
      }
    }
  },
  "submit": {
    "production": {
      "android": {
        "serviceAccountKeyPath": "./google-play-service-account.json",
        "track": "alpha"
      },
      "ios": {
        "ascApiKeyPath": "./AuthKey_T4K9ZTB9VV.p8",
        "ascApiKeyIssuerId": "c60673ac-14fe-4ffb-ada0-b2ced34faf6f",
        "ascApiKeyId": "T4K9ZTB9VV",
        "appleTeamId": "PPPF27LDWQ",
        "ascAppId": "6780579199"
      }
    }
  }
}
